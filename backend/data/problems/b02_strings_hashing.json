 {
  "id": "isomorphic-strings",
  "sourceTitle": "Isomorphic String",
  "topic": "String",
  "difficulty": "Easy",
  "structureType": "hashmap",
  "reviewStatus": "verified",
  "reviewedAt": "2026-09-16",
  "title": "Isomorphic Strings",
  "description": "Two strings are isomorphic when the characters of s can be replaced, one for one, to produce t: each character maps to exactly one character and no two characters map to the same one. Return whether s and t are isomorphic.",
  "constraints": [
   "1 <= s.length == t.length <= 5 * 10^4",
   "s and t contain printable ASCII characters."
  ],
  "examples": [
   {
    "input": {
     "s": "egg",
     "t": "add"
    },
    "output": true
   },
   {
    "input": {
     "s": "foo",
     "t": "bar"
    },
    "output": false
   },
   {
    "input": {
     "s": "paper",
     "t": "title"
    },
    "output": true
   }
  ],
  "signature": {
   "functionName": "is_isomorphic",
   "parameters": [
    {
     "name": "s",
     "kind": "string"
    },
    {
     "name": "t",
     "kind": "string"
    }
   ],
   "returnKind": "bool"
  },
  "starterCode": "def is_isomorphic(s, t):\n    # Write your solution here.\n    return False\n",
  "referenceCode": "def is_isomorphic(s, t):\n    forward = {}\n    backward = {}\n    for a, b in zip(s, t):\n        if forward.get(a, b) != b or backward.get(b, a) != a:\n            return False\n        forward[a] = b\n        backward[b] = a\n    return True\n",
  "defaultInput": {
   "s": "egg",
   "t": "add"
  },
  "testCases": [
   {
