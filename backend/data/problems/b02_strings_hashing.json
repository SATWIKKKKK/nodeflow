  "starterCode": "def count_and_say(n):\n    # Write your solution here.\n    return \"\"\n",
  "referenceCode": "def count_and_say(n):\n    term = \"1\"\n    for _ in range(n - 1):\n        parts = []\n        index = 0\n        while index < len(term):\n            run = index\n            while run < len(term) and term[run] == term[index]:\n                run += 1\n            parts.append(str(run - index) + term[index])\n            index = run\n        term = \"\".join(parts)\n    return term\n",
