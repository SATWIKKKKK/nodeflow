    "input": {
     "text": "hello",
     "pattern": "xyz"
    },
    "output": []
   }
  ],
  "signature": {
   "functionName": "find_occurrences",
   "parameters": [
    {
     "name": "text",
     "kind": "string"
    },
    {
     "name": "pattern",
     "kind": "string"
    }
   ],
   "returnKind": "array"
  },
  "starterCode": "def find_occurrences(text, pattern):\n    # Write your solution here.\n    return []\n",
  "referenceCode": "def find_occurrences(text, pattern):\n    base, mod = 31, 1000000007\n    m, n = len(pattern), len(text)\n    if m > n:\n        return []\n    power = 1\n    for _ in range(m - 1):\n        power = power * base % mod\n    target = 0\n    window = 0\n    for i in range(m):\n        target = (target * base + ord(pattern[i])) % mod\n        window = (window * base + ord(text[i])) % mod\n    found = []\n    for start in range(n - m + 1):\n        if window == target and text[start:start + m] == pattern:\n            found.append(start)\n        if start + m < n:\n            window = (window - ord(text[start]) * power) % mod\n            window = (window * base + ord(text[start + m])) % mod\n    return found\n",
  "defaultInput": {
   "text": "abababab",
   "pattern": "aba"
  },
  "testCases": [
