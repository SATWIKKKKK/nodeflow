  "reviewedAt": "2026-09-16",
  "title": "Largest Odd Number in a String",
  "description": "num is a string of digits. Return the largest odd number that is a non-empty prefix of num, written without leading zeros, or an empty string if no prefix is odd. (The largest odd prefix always ends at the last odd digit.)",
  "constraints": [
   "1 <= num.length <= 10^5",
   "num contains only digits and may start with zeros."
  ],
  "examples": [
   {
    "input": {
     "num": "52"
    },
    "output": "5"
   },
   {
    "input": {
     "num": "4206"
    },
    "output": ""
   },
   {
    "input": {
     "num": "0032"
    },
    "output": "3",
    "explanation": "The prefix 003 is odd; without leading zeros it is 3."
   }
  ],
  "signature": {
   "functionName": "largest_odd_number",
   "parameters": [
    {
     "name": "num",
     "kind": "string"
    }
   ],
   "returnKind": "string"
  },
  "starterCode": "def largest_odd_number(num):\n    # Write your solution here.\n    return \"\"\n",
  "referenceCode": "def largest_odd_number(num):\n    end = len(num) - 1\n    while end >= 0 and int(num[end]) % 2 == 0:\n        end -= 1\n    if end < 0:\n        return \"\"\n    start = 0\n    while start < end and num[start] == \"0\":\n        start += 1\n    return num[start:end + 1]\n",
  "defaultInput": {
   "num": "52"
  },
  "testCases": [
