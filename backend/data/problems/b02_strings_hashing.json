  "title": "Second Most Frequent Element",
  "description": "Count how often each value appears in nums. Find the second-highest distinct frequency and return the smallest value that occurs exactly that many times. If every value shares one frequency, return -1.",
  "constraints": [
   "1 <= nums.length <= 10^4",
   "-10^4 <= nums[i] <= 10^4"
  ],
  "examples": [
   {
    "input": {
     "nums": [
      1,
      2,
      2,
      3,
      3,
      3
     ]
    },
    "output": 2,
    "explanation": "3 appears three times, 2 appears twice."
   },
   {
    "input": {
     "nums": [
      4,
      4,
      4
     ]
    },
    "output": -1
   },
   {
    "input": {
     "nums": [
      1,
      1,
      2,
      2,
      3
     ]
    },
    "output": 3,
    "explanation": "1 and 2 tie on two; the next frequency is one, held by 3."
   }
  ],
  "signature": {
   "functionName": "second_most_frequent",
   "parameters": [
    {
     "name": "nums",
     "kind": "array"
    }
   ],
   "returnKind": "int"
  },
  "starterCode": "def second_most_frequent(nums):\n    # Write your solution here.\n    return 0\n",
  "referenceCode": "def second_most_frequent(nums):\n    counts = {}\n    for value in nums:\n        counts[value] = counts.get(value, 0) + 1\n    levels = sorted(set(counts.values()), reverse=True)\n    if len(levels) < 2:\n        return -1\n    target = levels[1]\n    return min(value for value, count in counts.items() if count == target)\n",
  "defaultInput": {
