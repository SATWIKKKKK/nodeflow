  "reviewedAt": "2026-09-16",
  "title": "Valid Palindrome",
  "description": "Return whether s is a palindrome once you ignore every character that is not a letter or digit and treat upper and lower case as equal.",
  "constraints": [
   "1 <= s.length <= 2 * 10^5",
   "s contains printable ASCII characters."
  ],
  "examples": [
   {
    "input": {
     "s": "A man, a plan, a canal: Panama"
    },
    "output": true
   },
   {
    "input": {
     "s": "race a car"
    },
    "output": false
   }
  ],
  "signature": {
   "functionName": "is_palindrome",
   "parameters": [
    {
     "name": "s",
     "kind": "string"
    }
   ],
   "returnKind": "bool"
  },
  "starterCode": "def is_palindrome(s):\n    # Write your solution here.\n    return False\n",
  "referenceCode": "def is_palindrome(s):\n    left, right = 0, len(s) - 1\n    while left < right:\n        if not s[left].isalnum():\n            left += 1\n        elif not s[right].isalnum():\n            right -= 1\n        elif s[left].lower() != s[right].lower():\n            return False\n        else:\n            left += 1\n            right -= 1\n    return True\n",
  "defaultInput": {
   "s": "A man, a plan, a canal: Panama"
  },
  "testCases": [
