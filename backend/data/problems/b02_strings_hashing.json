  "title": "Pattern Search with Rolling Hash",
  "description": "Return every index where pattern starts inside text, in increasing order. Compare rolling hashes of each window first and only check characters when the hashes agree.",
  "constraints": [
   "1 <= pattern.length <= text.length <= 10^5",
   "Lowercase English letters."
  ],
  "examples": [
   {
    "input": {
     "text": "abababab",
     "pattern": "aba"
    },
    "output": [
     0,
     2,
     4
    ]
   },
