 {
  "id": "reverse-string-blocks",
  "sourceTitle": "Reverse a String II",
  "topic": "String",
  "difficulty": "Easy",
  "structureType": "string",
  "reviewStatus": "verified",
  "reviewedAt": "2026-09-16",
  "title": "Reverse in Blocks",
  "description": "Walk through s in blocks of 2k characters. In each block, reverse the first k characters and leave the rest. If fewer than k characters remain, reverse all of them; if between k and 2k remain, reverse the first k.",
  "constraints": [
   "1 <= s.length <= 10^4",
   "1 <= k <= 10^4",
   "s contains lowercase English letters."
  ],
  "examples": [
   {
    "input": {
     "s": "abcdefg",
     "k": 2
    },
    "output": "bacdfeg"
   },
   {
    "input": {
     "s": "abcd",
     "k": 4
    },
    "output": "dcba"
   }
  ],
  "signature": {
   "functionName": "reverse_blocks",
   "parameters": [
    {
     "name": "s",
     "kind": "string"
    },
    {
     "name": "k",
     "kind": "int"
    }
   ],
   "returnKind": "string"
  },
  "starterCode": "def reverse_blocks(s, k):\n    # Write your solution here.\n    return \"\"\n",
  "referenceCode": "def reverse_blocks(s, k):\n    chars = list(s)\n    for start in range(0, len(chars), 2 * k):\n        left, right = start, min(start + k, len(chars)) - 1\n        while left < right:\n            chars[left], chars[right] = chars[right], chars[left]\n            left += 1\n            right -= 1\n    return \"\".join(chars)\n",
  "defaultInput": {
   "s": "abcdefg",
   "k": 2
  },
  "testCases": [
   {
    "id": "sample-1",
    "input": {
     "s": "abcdefg",
     "k": 2
    },
    "expectedOutput": "bacdfeg",
    "visible": true
   },
   {
    "id": "sample-2",
    "input": {
     "s": "abcd",
     "k": 4
    },
    "expectedOutput": "dcba",
    "visible": true
   },
   {
    "id": "hidden-1",
    "input": {
     "s": "a",
     "k": 1
    },
    "expectedOutput": "a",
    "visible": false
   },
   {
    "id": "hidden-2",
    "input": {
     "s": "abcdefgh",
     "k": 3
    },
    "expectedOutput": "cbadefhg",
    "visible": false
   },
   {
