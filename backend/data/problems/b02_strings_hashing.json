    "input": {
     "s": "foo",
     "t": "bar"
    },
    "expectedOutput": false,
    "visible": true
   },
   {
    "id": "sample-3",
    "input": {
     "s": "paper",
     "t": "title"
    },
    "expectedOutput": true,
    "visible": true
   },
   {
