 {
  "id": "count-primes-up-to-n",
  "sourceTitle": "Count of Prime Numbers till N",
  "topic": "Math",
  "difficulty": "Medium",
  "structureType": "array",
  "reviewStatus": "verified",
  "reviewedAt": "2026-09-16",
  "title": "Count Primes up to N",
  "description": "Return how many prime numbers p satisfy 2 <= p <= n. A sieve that crosses out multiples in a boolean array is the classic approach.",
  "constraints": [
   "0 <= n <= 10^5"
  ],
  "examples": [
   {
    "input": {
     "n": 10
    },
    "output": 4,
    "explanation": "2, 3, 5 and 7"
   },
   {
    "input": {
     "n": 1
    },
    "output": 0
   }
  ],
  "signature": {
   "functionName": "count_primes",
   "parameters": [
    {
     "name": "n",
     "kind": "int"
    }
   ],
   "returnKind": "int"
  },
  "starterCode": "def count_primes(n):\n    # Write your solution here.\n    return 0\n",
  "referenceCode": "def count_primes(n):\n    if n < 2:\n        return 0\n    is_prime = [True] * (n + 1)\n    is_prime[0] = is_prime[1] = False\n    p = 2\n    while p * p <= n:\n        if is_prime[p]:\n            for multiple in range(p * p, n + 1, p):\n                is_prime[multiple] = False\n        p += 1\n    return sum(1 for flag in is_prime if flag)\n",
  "defaultInput": {
   "n": 10
  },
  "testCases": [
   {
    "id": "sample-1",
    "input": {
     "n": 10
    },
    "expectedOutput": 4,
    "visible": true
   },
   {
    "id": "sample-2",
    "input": {
     "n": 1
    },
    "expectedOutput": 0,
    "visible": true
   },
   {
    "id": "hidden-1",
    "input": {
     "n": 2
    },
    "expectedOutput": 1,
    "visible": false
   },
   {
    "id": "hidden-2",
    "input": {
