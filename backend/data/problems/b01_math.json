   "returnKind": "array"
  },
  "starterCode": "def prime_factors(n):\n    # Write your solution here.\n    return []\n",
  "referenceCode": "def prime_factors(n):\n    factors = []\n    d = 2\n    while d * d <= n:\n        while n % d == 0:\n            factors.append(d)\n            n //= d\n        d += 1\n    if n > 1:\n        factors.append(n)\n    return factors\n",
