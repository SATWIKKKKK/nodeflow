  "reviewedAt": "2026-09-16",
  "title": "Perfect Number",
  "description": "A perfect number equals the sum of its proper divisors (every positive divisor except itself). Return whether n is perfect. Checking divisors only up to \u221an keeps it fast.",
  "constraints": [
   "1 <= n <= 10^9"
  ],
  "examples": [
   {
    "input": {
     "n": 28
    },
    "output": true,
    "explanation": "1 + 2 + 4 + 7 + 14 = 28"
   },
   {
    "input": {
     "n": 12
    },
    "output": false
   }
  ],
  "signature": {
   "functionName": "is_perfect",
   "parameters": [
    {
     "name": "n",
     "kind": "int"
    }
   ],
   "returnKind": "bool"
  },
  "starterCode": "def is_perfect(n):\n    # Write your solution here.\n    return False\n",
  "referenceCode": "def is_perfect(n):\n    if n < 2:\n        return False\n    total = 1\n    d = 2\n    while d * d <= n:\n        if n % d == 0:\n            total += d\n            if d != n // d:\n                total += n // d\n        d += 1\n    return total == n\n",
  "defaultInput": {
   "n": 28
  },
