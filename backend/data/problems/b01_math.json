 {
  "id": "count-primes-in-ranges",
  "sourceTitle": "Count primes in range L to R",
  "topic": "Math",
  "difficulty": "Medium",
  "structureType": "array",
  "reviewStatus": "verified",
  "reviewedAt": "2026-09-16",
  "title": "Primes in Ranges",
  "description": "You are given several queries, each a pair [L, R]. For every query return how many primes lie in the closed range from L to R. Build one sieve and a prefix count so each query is answered in constant time.",
  "constraints": [
   "1 <= number of queries <= 1000",
   "1 <= L <= R <= 10^5"
  ],
  "examples": [
   {
    "input": {
     "queries": [
      [
       1,
       10
      ],
      [
       10,
       20
      ]
     ]
    },
    "output": [
     4,
     4
    ],
    "explanation": "2, 3, 5, 7 and then 11, 13, 17, 19"
   },
   {
    "input": {
     "queries": [
      [
       14,
       16
      ]
     ]
    },
    "output": [
     0
    ]
   }
  ],
  "signature": {
   "functionName": "count_primes_in_ranges",
   "parameters": [
    {
     "name": "queries",
     "kind": "matrix"
    }
   ],
   "returnKind": "array"
  },
  "starterCode": "def count_primes_in_ranges(queries):\n    # Write your solution here.\n    return []\n",
  "referenceCode": "def count_primes_in_ranges(queries):\n    limit = max((right for _, right in queries), default=1)\n    sieve = [True] * (limit + 1)\n    sieve[0] = False\n    if limit >= 1:\n        sieve[1] = False\n    p = 2\n    while p * p <= limit:\n        if sieve[p]:\n            for multiple in range(p * p, limit + 1, p):\n                sieve[multiple] = False\n        p += 1\n    prefix = [0] * (limit + 1)\n    for value in range(1, limit + 1):\n        prefix[value] = prefix[value - 1] + (1 if sieve[value] else 0)\n    return [prefix[right] - prefix[left - 1] for left, right in queries]\n",
  "defaultInput": {
   "queries": [
    [
     1,
     10
    ],
    [
     10,
     20
    ]
   ]
  },
  "testCases": [
   {
    "id": "sample-1",
    "input": {
     "queries": [
      [
       1,
       10
      ],
      [
       10,
       20
      ]
     ]
    },
    "expectedOutput": [
     4,
     4
    ],
    "visible": true
   },
   {
    "id": "sample-2",
    "input": {
     "queries": [
      [
       14,
       16
      ]
     ]
    },
    "expectedOutput": [
     0
    ],
    "visible": true
   },
   {
    "id": "hidden-1",
    "input": {
     "queries": [
      [
       1,
       1
      ]
     ]
    },
    "expectedOutput": [
     0
    ],
    "visible": false
   },
   {
    "id": "hidden-2",
    "input": {
     "queries": [
      [
       2,
       2
      ],
      [
       1,
       100
      ],
      [
       50,
       60
      ]
     ]
    },
    "expectedOutput": [
